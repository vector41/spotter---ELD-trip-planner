# Spotter — shared backend + frontend configuration
# Copy to .env: cp .env.example .env

# --- Site URLs (edit when hosting on your domain) ---
# Backend: where Django API is reachable (no trailing slash)
BACKEND_URL=http://127.0.0.1:8000
# Frontend: where users open the React app (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Production example:
# BACKEND_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com

# Optional comma-separated overrides (leave empty to derive from URLs above)
# ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
# CORS_ALLOWED_ORIGINS=https://www.yourdomain.com

# --- Django ---
SECRET_KEY=dev-only-change-in-production
DEBUG=True

# --- Geocoding / routing (OSM; no API keys) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSRM_URL=https://router.project-osrm.org/route/v1/driving
GEOCODING_USER_AGENT=SpotterELD/1.0 (FMCSA HOS trip planner)

# --- Local dev only ---
VITE_DEV_PORT=5173
